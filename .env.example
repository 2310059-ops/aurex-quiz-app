# AUREX Quiz App - Environment Variables
# Copy this file to .env and fill in the values

# Port the server listens on (Railway sets this automatically)
PORT=3000

# Path to the SQLite database file
# On Railway: set to /data/quiz.db after adding a persistent volume
# Locally: leave empty (defaults to ./quiz.db in the project root)
DB_PATH=

# (Optional) News API key for live news questions
NEWS_API_KEY=
